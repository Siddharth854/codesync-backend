# Never commit real values. Configure these in Vercel Project Settings > Environment Variables.
MONGODB_URI=mongodb+srv://...
MONGODB_DB=codesync
GITHUB_APP_CLIENT_ID=Iv1_REPLACE_ME
GITHUB_APP_CLIENT_SECRET=REPLACE_ME
# Generate 32 random bytes and base64-encode them; must decode to exactly 32 bytes.
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# At least 32 random characters. Used to sign CodeSync sessions.
SESSION_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Comma-separated exact callback URLs registered in the GitHub App, e.g. https://EXTENSION_ID.chromiumapp.org/github
ALLOWED_REDIRECT_URIS=https://EXTENSION_ID.chromiumapp.org/github
# Optional comma-separated origins if you later add a web frontend. Extension calls are not browser-origin restricted.
ALLOWED_ORIGINS=
